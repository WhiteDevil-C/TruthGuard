from pathlib import Path

import joblib
from fastapi import FastAPI
from pydantic import BaseModel, Field

app = FastAPI(
    title="TruthGuard API",
    description="ML-powered misinformation classification API",
    version="1.1.0",
)

MODEL_DIR = Path(__file__).resolve().parent / "model"
VECTORIZER_PATH = MODEL_DIR / "vectorizer.pkl"
CLASSIFIER_PATH = MODEL_DIR / "classifier.pkl"

# Load the trained artifacts once when the API starts.
if not VECTORIZER_PATH.exists() or not CLASSIFIER_PATH.exists():
    raise FileNotFoundError(
        "Trained model files are missing. Run "
        "python training/train_model.py from the backend directory."
    )

vectorizer = joblib.load(VECTORIZER_PATH)
classifier = joblib.load(CLASSIFIER_PATH)


class ClaimRequest(BaseModel):
    text: str = Field(..., min_length=1, max_length=10000)


@app.get("/")
def home():
    return {
        "message": "TruthGuard API is running",
        "status": "online",
        "model_loaded": True,
        "model": "TF-IDF + Logistic Regression",
    }


@app.post("/analyze")
def analyze_claim(request: ClaimRequest):
    claim = request.text.strip()

    if not claim:
        return {
            "label": "unknown",
            "confidence": 0.0,
            "message": "No claim provided",
        }

    features = vectorizer.transform([claim])
    predicted_label = classifier.predict(features)[0]
    probabilities = classifier.predict_proba(features)[0]

    class_probabilities = {
        str(label): round(float(probability), 4)
        for label, probability in zip(
            classifier.classes_, probabilities
        )
    }

    confidence = float(max(probabilities))

    return {
        "label": str(predicted_label),
        "confidence": round(confidence, 4),
        "claim": claim,
        "class_probabilities": class_probabilities,
        "message": (
            "Prediction generated by the trained model. "
            "This score is not proof that the claim is true or false."
        ),
    }
