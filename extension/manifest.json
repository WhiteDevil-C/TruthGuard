{
  "manifest_version": 3,
  "name": "TruthGuard",
  "version": "1.0.0",
  "description": "An Explainable AI browser extension for detecting online misinformation.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthGuard"
  }
}